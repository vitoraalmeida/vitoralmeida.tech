<!doctype html><html><head><title>{{.Title}}</title><meta name="description" content="{{.Description}}"></head><body><nav><a href="/"{{if eq .ActiveSection "home"}} aria-current="page"{{end}}>Home</a><a href="/blog"{{if eq .ActiveSection "blog"}} aria-current="page"{{end}}>Blog</a></nav><main>{{.Content}}</main></body></html>
