<!doctype html><html><head><title>{{.Title}}</title><meta name="description" content="{{.Description}}">{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}" />{{end}}{{.StructuredData}}</head><body><nav><a href="/"{{if eq .ActiveSection "home"}} aria-current="page"{{end}}>Home</a><a href="/blog"{{if eq .ActiveSection "blog"}} aria-current="page"{{end}}>Blog</a></nav><main>{{.Content}}</main></body></html>