<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Vitor Almeida" />
    <meta name="description" content="{{ .Description }}" />
    <meta
      name="keywords"
      content="sites, web, internet, blog, tecnologia, segurança da informação, seginfo, security, desenvolvimento"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title> {{ .Title }} </title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-956T7Y8NQX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-956T7Y8NQX');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <header class="header" id="navbar">
      <div class="header__logo">
        <a class="header__logo-link" href="/"{{ if eq .ActiveSection "home" }} aria-current="page"{{ end }}>vitor almeida</a>
      </div>
      <nav class="header__menu" aria-label="Navegação principal">
        <a class="header__link" href="/about.html"{{ if eq .ActiveSection "about" }} aria-current="page"{{ end }}>/Sobre</a>
        <a class="header__link" href="/blog.html"{{ if eq .ActiveSection "blog" }} aria-current="page"{{ end }}>/Blog</a>
        <a class="header__link" href="/portfolio.html"{{ if eq .ActiveSection "portfolio" }} aria-current="page"{{ end }}>/Projetos</a>
      </nav>
    </header>
    <main id="main-content">
      {{ .Content }}
    </main>
    <footer class="footer" id="footer">
      <h4>Página pessoal - Vitor Almeida</h4>
      <p class="footer-text">
        <em>Feito com Go, HTML e CSS |
        <a
            href="https://www.github.com/vitoraalmeida/vitoralmeida.tech"
            target="_blank"
            rel="noopener"
            >Veja o código</a>
        </em>
      </p>
    </footer>
    <script>
      var prevScrollpos = window.pageYOffset;
      window.onscroll = function() {
        var currentScrollPos = window.pageYOffset;
        if (prevScrollpos > currentScrollPos) {
          document.getElementById("navbar").style.top = "0";
        } else {
          document.getElementById("navbar").style.top =
            `-${document.getElementById("navbar").offsetHeight}px`;
        }
        if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight) {
          document.getElementById("navbar").style.top = "0";
        }
        prevScrollpos = currentScrollPos;
      }
    </script>
  </body>
</html>
