<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Vitor Almeida" />
    <meta name="description" content="{{ .Description }}" />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://giscus.app" />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="Vitor Almeida" />
    {{ if .Canonical }}
    <link rel="canonical" href="{{ .Canonical }}" />
    <meta property="og:url" content="{{ .Canonical }}" />
    <meta property="og:image" content="{{ .OGImage }}" />
    <meta name="twitter:image" content="{{ .OGImage }}" />
    {{ end }}
    <meta property="og:title" content="{{ .Title }}" />
    <meta property="og:description" content="{{ .Description }}" />
    <meta property="og:site_name" content="Vitor Almeida" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="{{ if eq .Type "article" }}article{{ else }}website{{ end }}" />
    {{ if eq .Type "article" }}<meta property="article:published_time" content="{{ .DateISO }}" />{{ end }}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ .Title }}" />
    <meta name="twitter:description" content="{{ .Description }}" />
    {{ .StructuredData }}
    <title> {{ .Title }} </title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <header class="header" id="navbar">
      <div class="header__logo">
        <span aria-hidden="true">[</span><a class="header__logo-link" href="/" aria-label="Página inicial"{{ if eq .ActiveSection "home" }} aria-current="page"{{ end }}>vitor@web</a><span aria-hidden="true"> ~]$</span>
      </div>
      <nav class="header__menu" aria-label="Navegação principal">
        <a class="header__link" href="/about"{{ if eq .ActiveSection "about" }} aria-current="page"{{ end }}>/Sobre</a>
        <a class="header__link" href="/blog"{{ if eq .ActiveSection "blog" }} aria-current="page"{{ end }}>/Blog</a>
        <a class="header__link" href="/portfolio"{{ if eq .ActiveSection "portfolio" }} aria-current="page"{{ end }}>/Projetos</a>
      </nav>
    </header>
    <main id="main-content">
      {{ .Content }}
    </main>
    <footer class="footer" id="footer">
      <p class="footer-text">
        <span class="footer__status">status: online</span>
        <span>Vitor Almeida</span>
        <span>feito com Go, HTML e CSS</span>
        <a
            href="https://www.github.com/vitoraalmeida/vitoralmeida.tech"
            target="_blank"
            rel="noopener"
            >código-fonte</a>
      </p>
    </footer>
    <script>
      (() => {
        const navbar = document.getElementById("navbar");
        let previousScrollPosition = window.scrollY;
        let updateRequested = false;

        const updateNavbar = () => {
          const currentScrollPosition = window.scrollY;
          const reachedPageEnd =
            window.innerHeight + currentScrollPosition >=
            document.documentElement.scrollHeight - 1;

          navbar.style.top =
            currentScrollPosition < previousScrollPosition || reachedPageEnd
              ? "0"
              : `-${navbar.offsetHeight}px`;

          previousScrollPosition = currentScrollPosition;
          updateRequested = false;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!updateRequested) {
              updateRequested = true;
              window.requestAnimationFrame(updateNavbar);
            }
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
