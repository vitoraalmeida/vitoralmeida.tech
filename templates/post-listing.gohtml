{{range .}}
<article class="post-short">
  <a class="post-short__link" href="/blog/{{ .Slug }}">
    <p class="post-short__date"><time datetime="{{ .DateISO }}">{{ .Date }}</time></p>
    <h3 class="post-short__title">{{ .Title }}</h3>
    <p class="post-short__subtitle">{{ .Description }}</p>
  </a>
</article>
{{ end }}
