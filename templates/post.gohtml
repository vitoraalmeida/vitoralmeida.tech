<section class="blog-post">
    <h1 id="top" class="blog-post__page-title">
    {{ .Title }}
    </h1>

    <section class="post-meta">
    <p class="post-meta__subtitle">
        <em>{{ .Description }}</em>
    </p>
    <p class="post-meta__date">Publicado em <time datetime="{{ .DateISO }}">{{ .Date }}</time></p>
    </section>

    {{ with .TableOfContents }}
    <details class="table-of-contents" open>
        <summary class="table-of-contents__summary">Neste artigo</summary>
        <nav class="table-of-contents__navigation" aria-labelledby="table-of-contents-title">
            <h2 class="table-of-contents__title" id="table-of-contents-title">Neste artigo</h2>
            <ol class="table-of-contents__list">
                {{ range . }}
                <li class="table-of-contents__item">
                    <a class="table-of-contents__link" href="#{{ .ID }}">{{ .Title }}</a>
                    {{ with .Children }}
                    <ol class="table-of-contents__list table-of-contents__list--nested">
                        {{ range . }}
                        <li class="table-of-contents__item">
                            <a class="table-of-contents__link" href="#{{ .ID }}">{{ .Title }}</a>
                        </li>
                        {{ end }}
                    </ol>
                    {{ end }}
                </li>
                {{ end }}
            </ol>
        </nav>
    </details>
    {{ end }}

    <article class="blog-post__article">
        {{ .Content }}
    </article>

    {{ if or .Older .Newer }}
    <nav class="post-navigation" aria-label="Navegação entre artigos">
        {{ if .Older }}
        <a class="post-navigation__link post-navigation__link--older" href="/blog/{{ .Older.Slug }}">
            <span class="post-navigation__direction">← Mais antigo</span>
            <span>{{ .Older.Title }}</span>
        </a>
        {{ end }}
        {{ if .Newer }}
        <a class="post-navigation__link post-navigation__link--newer" href="/blog/{{ .Newer.Slug }}">
            <span class="post-navigation__direction">Mais recente →</span>
            <span>{{ .Newer.Title }}</span>
        </a>
        {{ end }}
    </nav>
    {{ end }}

    <a href="#top">Voltar ao topo</a>

    <div id="comments"></div>
    <script>
      (() => {
        const comments = document.getElementById("comments");
        const footer = document.getElementById("footer");
        let loaded = false;

        const loadComments = () => {
          if (loaded) return;
          loaded = true;
          const script = document.createElement("script");
          script.src = "https://giscus.app/client.js";
          script.async = true;
          script.crossOrigin = "anonymous";
          script.dataset.repo = "vitoraalmeida/vitoralmeida.tech";
          script.dataset.repoId = "R_kgDOKGa4Ng";
          script.dataset.category = "Ideas";
          script.dataset.categoryId = "DIC_kwDOKGa4Ns4CkwVC";
          script.dataset.mapping = "title";
          script.dataset.strict = "0";
          script.dataset.reactionsEnabled = "1";
          script.dataset.emitMetadata = "0";
          script.dataset.inputPosition = "top";
          script.dataset.theme = "preferred_color_scheme";
          script.dataset.lang = "pt";
          comments.append(script);
        };

        if (!footer || !("IntersectionObserver" in window)) {
          loadComments();
          return;
        }
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            observer.disconnect();
            loadComments();
          },
          { rootMargin: "800px 0px" }
        );
        observer.observe(footer);
      })();
    </script>
</section>
