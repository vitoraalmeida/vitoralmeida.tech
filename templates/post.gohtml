<section class="blog-post">
    <h1 id="top" class="blog-post-page-title">
    {{ .Title }}
    </h1>

    <section class="post-meta">
    <h2 class="post-meta__subtitle">
        <em>{{ .Description }}</em>
    </h2>
    <p class="post-meta__date">Publicado em <time datetime="{{ .DateISO }}">{{ .Date }}</time></p>
    </section>

    {{ with .TableOfContents }}
    <details class="table-of-contents" open>
        <summary class="table-of-contents__summary">Neste artigo</summary>
        <nav class="table-of-contents__navigation" aria-labelledby="table-of-contents-title">
            <h2 class="table-of-contents__title" id="table-of-contents-title">Neste artigo</h2>
            <ol class="table-of-contents__list">
                {{ range . }}
                <li class="table-of-contents__item">
                    <a class="table-of-contents__link" href="#{{ .ID }}">{{ .Title }}</a>
                    {{ with .Children }}
                    <ol class="table-of-contents__list table-of-contents__list--nested">
                        {{ range . }}
                        <li class="table-of-contents__item">
                            <a class="table-of-contents__link" href="#{{ .ID }}">{{ .Title }}</a>
                        </li>
                        {{ end }}
                    </ol>
                    {{ end }}
                </li>
                {{ end }}
            </ol>
        </nav>
    </details>
    {{ end }}

    <article class="blog-post__article">
        {{ .Content }}
    </article>

    {{ if or .Older .Newer }}
    <nav class="post-navigation" aria-label="Navegação entre artigos">
        {{ if .Older }}
        <a class="post-navigation__link post-navigation__link--older" href="/blog/{{ .Older.Slug }}.html">
            <span class="post-navigation__direction">← Mais antigo</span>
            <span>{{ .Older.Title }}</span>
        </a>
        {{ end }}
        {{ if .Newer }}
        <a class="post-navigation__link post-navigation__link--newer" href="/blog/{{ .Newer.Slug }}.html">
            <span class="post-navigation__direction">Mais recente →</span>
            <span>{{ .Newer.Title }}</span>
        </a>
        {{ end }}
    </nav>
    {{ end }}

    <a href="#top">Voltar ao topo</a>

    <script src="https://giscus.app/client.js"
            data-repo="vitoraalmeida/vitoralmeida.tech"
            data-repo-id="R_kgDOKGa4Ng"
            data-category="Ideas"
            data-category-id="DIC_kwDOKGa4Ns4CkwVC"
            data-mapping="title"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="pt"
            crossorigin="anonymous"
            async>
    </script>
</section>
